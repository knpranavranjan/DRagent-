# ---------------------------------------------------------------------------
# OPHIRA DRagent — what never belongs in version control
# ---------------------------------------------------------------------------

# RUNTIME PATIENT DATA. This is where captures, job files, generated reports
# and agent traces land. It is clinical data, not source. The directory
# skeleton is tracked (see the .gitkeep rules below) because the app needs
# it to exist; nothing inside it is.
data/sessions/**
!data/sessions/
!data/sessions/*/
!data/sessions/jobs/*/
!data/sessions/**/.gitkeep

# Generated at runtime.
artifacts/logs/
artifacts/reports/
artifacts/demo/
artifacts/ui/
artifacts/e2e_sessions/

# Python build artefacts.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node, only used by the browser tests.
node_modules/
package-lock.json

# Editor and OS noise.
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# MATLAB scratch.
*.asv
*.m~
slprj/

# Downloaded tunnel client (55 MB). Not source; run.py finds it here or on
# PATH, and DEPLOY_REMOTE.md says how to fetch it.
tools/

# The saved access key. A credential, not configuration.
.ophira_key
